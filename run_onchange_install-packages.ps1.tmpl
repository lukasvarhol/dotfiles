{{ if eq .chezmoi.os "windows" -}}
# Self-elevate the script if required
if (-Not ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole] 'Administrator')) {
  if ([int](Get-CimInstance -Class Win32_OperatingSystem | Select-Object -ExpandProperty BuildNumber) -ge 6000) {
    $CommandLine = "-NoExit -File `"" + $MyInvocation.MyCommand.Path + "`" " + $MyInvocation.UnboundArguments
    Start-Process -Wait -FilePath pwsh.exe -Verb Runas -ArgumentList $CommandLine
    Exit
  }
}

winget install --id=Python.Python.3.12 -e;
winget install --id=EclipseAdoptium.Temurin.21.JDK -e;
winget install --id=Kitware.CMake -e;
winget install --id=LLVM.clangd -e;
winget install --id=Microsoft.VisualStudio.2022.BuildTools -e;
winget install --id=FSFhu.Hunspell -e;
winget install --id=GoLang.Go -e;
winget install --id=Rustlang.Rustup -e;
winget install --id=OpenJS.NodeJS -e;
winget install --id=MSYS2.MSYS2 -e;

py -3.12 -m pip install --user cmake-language-server basedpyright tclint

$env:Path = [System.Environment]::GetEnvironmentVariable('Path', 'Machine') + ";" + [System.Environment]::GetEnvironmentVariable('Path', 'User')
go install golang.org/x/tools/gopls@latest

rustup component add rust-analyzer
$raPath = rustup which rust-analyzer
$cargoPath = "$env:USERPROFILE\.cargo\bin\rust-analyzer.exe"
Copy-Item $raPath $cargoPath
New-Item -ItemType Directory -Force -Path "C:\tools"
Copy-Item "$env:USERPROFILE\.cargo\bin\rust-analyzer.exe" "C:\tools\rust-analyzer.exe"
Copy-Item "$env:APPDATA\Python\Python312\Scripts\tclsp.exe" "C:\tools\tclsp.exe"

npm install -g typescript-language-server typescript

# Point HOME at the user profile so Emacs reads ~/.emacs.d (where chezmoi puts it)
# instead of falling back to %APPDATA%\.emacs.d
if ([System.Environment]::GetEnvironmentVariable('HOME', 'User') -ne $env:USERPROFILE) {
    [System.Environment]::SetEnvironmentVariable('HOME', $env:USERPROFILE, 'User')
}

# Install vcpkg
if (!(Test-Path "C:\vcpkg")) {
    git clone https://github.com/microsoft/vcpkg C:\vcpkg
    C:\vcpkg\bootstrap-vcpkg.bat
    C:\vcpkg\vcpkg integrate install
}

# Install Verible Verilog Language Server
if (!(Test-Path "C:\verible")) {
    $url = (Invoke-WebRequest -Uri "https://api.github.com/repos/chipsalliance/verible/releases/latest" -UseBasicParsing | ConvertFrom-Json).assets | Where-Object { $_.name -like "*win64*" } | Select-Object -ExpandProperty browser_download_url
    Invoke-WebRequest -Uri $url -UseBasicParsing -OutFile "$env:TEMP\verible.zip"
    Expand-Archive -Path "$env:TEMP\verible.zip" -DestinationPath "$env:TEMP\verible_extract\"
    $extractedDir = Get-ChildItem -Path "$env:TEMP\verible_extract" | Select-Object -First 1
    Move-Item -Path $extractedDir.FullName -Destination "C:\verible"
}

# Install VHDL_LS
if (!(Test-Path "C:\vhdl_ls")) {
    $url = (Invoke-WebRequest -Uri "https://api.github.com/repos/VHDL-LS/rust_hdl/releases/latest" -UseBasicParsing | ConvertFrom-Json).assets | Where-Object { $_.name -like "vhdl_ls-x86_64-pc-windows-msvc*" } | Select-Object -ExpandProperty browser_download_url
    Invoke-WebRequest -Uri $url -UseBasicParsing -OutFile "$env:TEMP\vhdl_ls.zip"
    Expand-Archive -Path "$env:TEMP\vhdl_ls.zip" -DestinationPath "$env:TEMP\vhdl_ls_extract\"
    $extractedDir = Get-ChildItem -Path "$env:TEMP\vhdl_ls_extract" | Select-Object -First 1
    Move-Item -Path $extractedDir.FullName -Destination "C:\vhdl_ls"
}

# Install jdtls (Java Language Server)
if (!(Test-Path "C:\jdtls")) {
    Invoke-WebRequest -Uri "https://download.eclipse.org/jdtls/snapshots/jdt-language-server-latest.tar.gz" -UseBasicParsing -OutFile "$env:TEMP\jdtls.tar.gz"
    New-Item -ItemType Directory -Force -Path "C:\jdtls"
    tar -xzf "$env:TEMP\jdtls.tar.gz" -C "C:\jdtls"
}

# Install texlab (LaTeX language server) into C:\tools
if (!(Test-Path "C:\tools\texlab.exe")) {
    $url = (Invoke-WebRequest -Uri "https://api.github.com/repos/latex-lsp/texlab/releases/latest" -UseBasicParsing | ConvertFrom-Json).assets | Where-Object { $_.name -eq "texlab-x86_64-windows.zip" } | Select-Object -ExpandProperty browser_download_url
    Invoke-WebRequest -Uri $url -UseBasicParsing -OutFile "$env:TEMP\texlab.zip"
    Expand-Archive -Path "$env:TEMP\texlab.zip" -DestinationPath "C:\tools" -Force
}

# Install TeX Live (scheme-medium, no docs/sources). The installer adds its own
# year-specific bin directory to PATH, so nothing is hardcoded here.
if (!(Test-Path "C:\texlive")) {
    Invoke-WebRequest -Uri "https://mirror.ctan.org/systems/texlive/tlnet/install-tl.zip" -UseBasicParsing -OutFile "$env:TEMP\install-tl.zip"
    Remove-Item -Recurse -Force "$env:TEMP\install-tl" -ErrorAction SilentlyContinue
    Expand-Archive -Path "$env:TEMP\install-tl.zip" -DestinationPath "$env:TEMP\install-tl" -Force
    $installer = Get-ChildItem -Path "$env:TEMP\install-tl" -Directory | Select-Object -First 1
    & "$($installer.FullName)\install-tl-windows.bat" -no-gui -no-interaction -scheme scheme-medium -no-doc-install -no-src-install
}

# Install the pdf-tools server (epdfinfo) via MSYS2
if (!(Test-Path "C:\msys64\ucrt64\bin\epdfinfo.exe")) {
    & "C:\msys64\usr\bin\bash.exe" -lc "pacman -Syu --noconfirm"
    & "C:\msys64\usr\bin\bash.exe" -lc "pacman -S --noconfirm --needed mingw-w64-ucrt-x86_64-emacs-pdf-tools-server"
}

# Install Iosevka Nerd Font
if (!(Test-Path "C:\Windows\Fonts\IosevkaNerdFontMono-Regular.ttf")) {
    $url = (Invoke-WebRequest -Uri "https://api.github.com/repos/ryanoasis/nerd-fonts/releases/latest" -UseBasicParsing | ConvertFrom-Json).assets | Where-Object { $_.name -eq "Iosevka.zip" } | Select-Object -ExpandProperty browser_download_url
    Invoke-WebRequest -Uri $url -UseBasicParsing -OutFile "$env:TEMP\iosevka.zip"
    Remove-Item -Recurse -Force "$env:TEMP\iosevka" -ErrorAction SilentlyContinue
    Expand-Archive -Path "$env:TEMP\iosevka.zip" -DestinationPath "$env:TEMP\iosevka" -Force

    Add-Type -AssemblyName System.Drawing
    $FontList = Get-ChildItem -Path "$env:TEMP\iosevka\*" -Include ('*.fon','*.otf','*.ttc','*.ttf')
    foreach ($Font in $FontList) {
        $collection = New-Object System.Drawing.Text.PrivateFontCollection
        $collection.AddFontFile($Font.FullName)
        $familyName = $collection.Families[0].Name

        # crude style detection from filename, good enough for registry naming
        $style = ""
        if ($Font.BaseName -match "Bold" -and $Font.BaseName -match "Italic|Oblique") { $style = " Bold Italic" }
        elseif ($Font.BaseName -match "Bold") { $style = " Bold" }
        elseif ($Font.BaseName -match "Italic|Oblique") { $style = " Italic" }

        $regName = "$familyName$style (TrueType)"
        Write-Host "Installing font -" $regName
        Copy-Item $Font.FullName "C:\Windows\Fonts" -Force
        New-ItemProperty -Name $regName -Path "HKLM:\Software\Microsoft\Windows NT\CurrentVersion\Fonts" -PropertyType string -Value $Font.name -Force | Out-Null
    }
}

# Ensure tool bin directories are on PATH
$machinePath = [System.Environment]::GetEnvironmentVariable('Path', 'Machine')
$pathsToAdd = @("C:\verible", "C:\vhdl_ls\bin", "C:\tools", "C:\jdtls\bin", "C:\msys64\ucrt64\bin", "$env:USERPROFILE\go\bin")

# Find the newest installed Emacs instead of hardcoding its version
$emacsDir = Get-ChildItem "C:\Program Files\Emacs" -Directory -Filter "emacs-*" -ErrorAction SilentlyContinue |
    Sort-Object { [version]($_.Name -replace '^emacs-', '') } -Descending |
    Select-Object -First 1
if ($emacsDir) { $pathsToAdd += "$($emacsDir.FullName)\bin" }

foreach ($p in $pathsToAdd) {
    if ($machinePath -notlike "*$p*") {
        $machinePath = "$machinePath;$p"
    }
}
[System.Environment]::SetEnvironmentVariable('Path', $machinePath, 'Machine')

# Install hunspell en_GB dictionary
if (!(Test-Path "C:\Hunspell\en_GB.dic")) {
    New-Item -ItemType Directory -Force -Path "C:\Hunspell"
    Invoke-WebRequest -Uri "https://raw.githubusercontent.com/LibreOffice/dictionaries/master/en/en_GB.dic" -UseBasicParsing -OutFile "C:\Hunspell\en_GB.dic"
    Invoke-WebRequest -Uri "https://raw.githubusercontent.com/LibreOffice/dictionaries/master/en/en_GB.aff" -UseBasicParsing -OutFile "C:\Hunspell\en_GB.aff"
}
{{ end -}}
